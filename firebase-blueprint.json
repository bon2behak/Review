{
  "entities": {
    "Review": {
      "title": "Review",
      "description": "Student lesson review submissions, teacher grading, and parent feedback",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "studentClass": { "type": "string" },
        "studentAvatar": { "type": "string" },
        "subject": { "type": "string" },
        "title": { "type": "string" },
        "chapter": { "type": "string" },
        "feedback": { "type": "string" },
        "deadline": { "type": "string" },
        "status": { "type": "string" },
        "urgent": { "type": "boolean" },
        "score": { "type": "number" },
        "date": { "type": "string" },
        "submittedAt": { "type": "string" },
        "myText": { "type": "string" },
        "reflection": { "type": "string" },
        "teacherName": { "type": "string" },
        "parentReaction": { "type": "string" },
        "parentComment": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "studentId", "studentName", "subject", "title", "myText", "status"]
    },
    "AppNotification": {
      "title": "AppNotification",
      "description": "Notifications across student, teacher, and parent roles",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "targetRole": { "type": "string" },
        "targetUserId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "timestamp": { "type": "string" },
        "read": { "type": "boolean" },
        "type": { "type": "string" },
        "relatedReviewId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "targetRole", "title", "message", "type"]
    },
    "TaskItem": {
      "title": "TaskItem",
      "description": "Reading and learning tasks assigned to students",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "subject": { "type": "string" },
        "title": { "type": "string" },
        "pages": { "type": "string" },
        "deadline": { "type": "string" },
        "rewardPoints": { "type": "number" },
        "completed": { "type": "boolean" },
        "tag": { "type": "string" }
      },
      "required": ["id", "subject", "title"]
    },
    "RewardItem": {
      "title": "RewardItem",
      "description": "Reward items redeemable with study points",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "cost": { "type": "number" },
        "icon": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "redeemedCount": { "type": "number" }
      },
      "required": ["id", "name", "cost"]
    }
  },
  "firestore": {
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Educational reviews created by students, graded by teachers, cheered by parents"
    },
    "/notifications/{notifId}": {
      "schema": "AppNotification",
      "description": "Real-time alerts for reviews, grading, and cheer interactions"
    },
    "/tasks/{taskId}": {
      "schema": "TaskItem",
      "description": "Assigned study and reading tasks"
    },
    "/rewards/{rewardId}": {
      "schema": "RewardItem",
      "description": "Redeemable learning rewards"
    }
  }
}
